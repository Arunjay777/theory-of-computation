<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>pda</type>
	<automaton>
		<state id="0" name="q0">
			<x>100.0</x>
			<y>150.0</y>
			<initial/>
		</state>
		<state id="1" name="q1">
			<x>260.0</x>
			<y>150.0</y>
		</state>
		<state id="2" name="q2">
			<x>420.0</x>
			<y>150.0</y>
			<final/>
		</state>
		<!-- Push TWO A's for each 'a' -->
		<transition>
			<from>0</from>
			<to>0</to>
			<read>a</read>
			<pop>Z</pop>
			<push>AAZ</push>
		</transition>
		<transition>
			<from>0</from>
			<to>0</to>
			<read>a</read>
			<pop>A</pop>
			<push>AAA</push>
		</transition>
		<!-- Pop ONE A for each 'b' -->
		<transition>
			<from>0</from>
			<to>1</to>
			<read>b</read>
			<pop>A</pop>
			<push/>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>b</read>
			<pop>A</pop>
			<push/>
		</transition>
		<!-- Accept by final state -->
		<transition>
			<from>1</from>
			<to>2</to>
			<read/>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
	</automaton>
</structure>
